# Базовый URL приложения
BASE_URL=https://ru.yougile.com

# Учётные данные для входа в YouGile
YOUGILE_LOGIN=your_email@example.com
YOUGILE_PASSWORD=your_password

# Токен API (получить через POST /api-v2/auth/keys)
YOUGILE_TOKEN=your_api_token

# Браузер для UI-тестов (chrome, firefox)
BROWSER=chrome